  "search-no-match": [
    {
      "id": "AC-1",
      "statement": "The header Sign in button is visible on the home page.",
      "expectedOutcome": {
        "kind": "visible",
        "fact": {
          "key": "signInButtonVisible",
          "checkpoint": "home_page"
        },
        "expected": true
      }
    },
    {
      "id": "AC-2",
      "statement": "After submitting the search, the browser is on the search results URL containing /search?search=codex-no-product-20261109.",
      "expectedOutcome": {
        "kind": "text_matches",
        "fact": {
          "key": "url",
          "checkpoint": "search_results"
        },
        "match": {
          "mode": "contains",
          "value": "/search?search=codex-no-product-20261109",
          "caseSensitive": false
        }
      }
    },
    {
      "id": "AC-3",
      "statement": "The search results page heading contains the exact query codex-no-product-20261109.",
      "expectedOutcome": {
        "kind": "text_matches",
        "fact": {
          "key": "searchResultHeading",
          "checkpoint": "search_results"
        },
        "match": {
          "mode": "contains",
          "value": "codex-no-product-20261109",
          "caseSensitive": false
        }
      }
    },
    {
      "id": "AC-4",
      "statement": "The search result grid displays zero product result cards for the nonexistent query.",
      "expectedOutcome": {
        "kind": "numeric_compare",
        "left": {
          "key": "productResultCardCount",
          "checkpoint": "search_results"
        },
        "operator": "eq",
        "right": 0
      }
    },
    {
      "id": "AC-5",
      "statement": "The result grid shows none of the unrelated products ILARIO Product Variants, LAVENDA Product Variants, LINE Product Variants or Spatial 3D product.",
      "expectedOutcome": {
        "kind": "numeric_compare",
        "left": {
          "key": "unrelatedProductCardCount",
          "checkpoint": "search_results"
        },
        "operator": "eq",
        "right": 0
      }
    },
    {
      "id": "AC-6",
      "statement": "After reloading and finishing loading, the search result grid again shows zero product result cards.",
      "expectedOutcome": {
        "kind": "numeric_compare",
        "left": {
          "key": "productResultCardCount",
          "checkpoint": "search_results_after_reload"
        },
        "operator": "eq",
        "right": 0
      }
    }
  ]
}
