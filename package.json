{
  "name": "vibe-testing-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:live": "vitest run --project live",
    "eval": "tsx evals/run-evals.ts",
    "typecheck": "pnpm -r typecheck && tsc -p evals/tsconfig.json && tsc -p tests/e2e/tsconfig.json",
    "db:migrate": "pnpm --filter @platform/db migrate",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml up -d --wait postgres redis s3 demo-shop",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml down -v",
    "stack:up": "docker compose -f infra/compose/docker-compose.yml up -d --build --wait",
    "stack:down": "docker compose -f infra/compose/docker-compose.yml down",
    "test:e2e:live": "E2E_MODE=live vitest run --project e2e",
    "test:e2e:compose": "E2E_PLATFORM=compose vitest run --project e2e"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/db": "workspace:*",
    "@platform/demo-shop": "workspace:*",
    "@platform/event-bus": "workspace:*",
    "@platform/llm": "workspace:*",
    "@platform/security": "workspace:*",
    "@platform/stagehand-adapter": "workspace:*",
    "@platform/storage": "workspace:*",
    "@platform/testing-engine": "workspace:*",
    "@types/node": "^22.19.0",
    "drizzle-orm": "^0.45.3",
    "esbuild": "~0.28.2",
    "ioredis": "^6.0.0",
    "playwright-core": "1.56.1",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1",
    "zod": "4.4.3"
  }
}
