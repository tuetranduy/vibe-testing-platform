# Copy to .env and adjust. Loaded by api, worker, and web server at startup.
NODE_ENV=development
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
REDIS_URL=redis://localhost:6379

# Artifact storage: local (dev only) or s3 (rclone S3 server in compose)
ARTIFACT_STORAGE_TYPE=s3
ARTIFACT_BUCKET=artifacts
ARTIFACT_LOCAL_DIR=./.artifacts
S3_ENDPOINT=http://localhost:9000
# Endpoint signed artifact URLs are presigned against, if S3_ENDPOINT isn't reachable from the browser
# (compose sets http://localhost:9000 for the api, whose S3_ENDPOINT is http://s3:9000). Default: S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=s3admin
S3_SECRET_ACCESS_KEY=s3admin-secret
S3_FORCE_PATH_STYLE=true

# LLM provider: fake (dev/test only), anthropic, gemini (Gemini Developer API), deepseek, openai (not implemented in V1).
# LLM_PROVIDER, LLM_MODEL and GEMINI_THINKING_LEVEL are the defaults for new tests while the web UI's Settings hold
# none; a test can also pick its own model and reasoning level. The api and the worker must see the same LLM_* values.
LLM_PROVIDER=fake
# The bare model id; empty: claude-sonnet-5 (anthropic), gemini-3.8-flash (gemini), deepseek-flash (deepseek).
# Another provider's model is rejected.
# LLM_MODEL=
# Provider keys are optional: Settings → AI providers can hold them (encrypted in the database with
# SECRETS_ENCRYPTION_KEY). A key set here is the server's, used for a provider with no key saved in Settings.
# ANTHROPIC_API_KEY=
# From a billing-enabled Google project: on the free tier Google may use prompts to improve its products.
# GEMINI_API_KEY=
# Gemini 3 models' thinking: minimal | low | medium | high (default: the model's own; not every model takes
# every level, e.g. gemini-3.8-flash has no minimal, and a mismatch fails the first call). Thinking tokens
# count against each call's output limit and are billed as output.
# GEMINI_THINKING_LEVEL=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

BROWSER_MODE=local
API_TOKEN=dev-api-token-change-me-please
API_PORT=3001
API_URL=http://localhost:3001
# Web app: the host[:port] names the UI is served on, comma-separated (the API proxy rejects any other Host).
# WEB_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
DEFAULT_TENANT_ID=t_default
# Web sign-in: the first administrator, created at API start while the tenant has no user (both or neither).
# Production refuses this example password.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin-password-change-me
# A web session's lifetime in hours.
SESSION_TTL_HOURS=12
# base64 of 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

MAX_ACTIVE_RUNS_PER_TENANT=3
# A suite schedule's least time between two runs, in minutes (V1.2).
SCHEDULE_MIN_INTERVAL_MINUTES=15
CONFIRMATION_TTL_HOURS=24
# Includes reading the live site (V1.3): up to 45 s of it, before the model call.
ANALYSIS_TIMEOUT_SECONDS=120
# A blank requirement's survey (explore the website, suggest tests): its hard deadline. Page loading stops at 60 % of it.
SURVEY_TIMEOUT_SECONDS=180
WORKER_CONCURRENCY=2
# Exploration videos (V1.3) are encoded with Playwright's bundled ffmpeg; set this to use another one.
# FFMPEG_PATH=
ARTIFACT_RETENTION_DAYS=30
SECRET_ARTIFACT_RETENTION_DAYS=7
# Playwright rerun (Task 17): per-run workspaces <dir>/<runId>/ (default: <os tmpdir>/platform-runs;
# /work/runs in the Docker image) and the node_modules holding @playwright/test (default: the worker's own).
# RUNNER_WORKSPACE_DIR=/work/runs
# RUNNER_NODE_MODULES_DIR=/opt/runner/node_modules
# dev/test only — never in production
TARGET_PRIVATE_ALLOWLIST=localhost:4000,demo-shop:4000
