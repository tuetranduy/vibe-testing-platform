# Copy to .env and adjust. Loaded by api, worker, and web server at startup.
NODE_ENV=development
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
REDIS_URL=redis://localhost:6379

# Artifact storage: local (dev only) or s3 (rclone S3 server in compose)
ARTIFACT_STORAGE_TYPE=s3
ARTIFACT_BUCKET=artifacts
ARTIFACT_LOCAL_DIR=./.artifacts
S3_ENDPOINT=http://localhost:9000
# Endpoint signed artifact URLs are presigned against, if S3_ENDPOINT isn't reachable from the browser
# (compose sets http://localhost:9000 for the api, whose S3_ENDPOINT is http://s3:9000). Default: S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=s3admin
S3_SECRET_ACCESS_KEY=s3admin-secret
S3_FORCE_PATH_STYLE=true

# LLM provider: fake (dev/test only), anthropic, openai (not implemented in V1)
LLM_PROVIDER=fake
# LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

BROWSER_MODE=local
API_TOKEN=dev-api-token-change-me-please
API_PORT=3001
API_URL=http://localhost:3001
DEFAULT_TENANT_ID=t_default
# base64 of 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

MAX_ACTIVE_RUNS_PER_TENANT=3
CONFIRMATION_TTL_HOURS=24
ANALYSIS_TIMEOUT_SECONDS=120
WORKER_CONCURRENCY=2
ARTIFACT_RETENTION_DAYS=30
SECRET_ARTIFACT_RETENTION_DAYS=7
# Playwright rerun (Task 17): per-run workspaces <dir>/<runId>/ (default: <os tmpdir>/platform-runs;
# /work/runs in the Docker image) and the node_modules holding @playwright/test (default: the worker's own).
# RUNNER_WORKSPACE_DIR=/work/runs
# RUNNER_NODE_MODULES_DIR=/opt/runner/node_modules
# dev/test only — never in production
TARGET_PRIVATE_ALLOWLIST=localhost:4000,demo-shop:4000
