# Copy to .env.production (git-ignored), fill in, then run scripts/deploy/set-github-secrets.sh.

# Supabase > Connect > Transaction pooler (port 6543), with the database password filled in.
# End it with ?uselibpqcompat=true&sslmode=require: without sslmode the connection is not encrypted.
DATABASE_URL=
# Managed Redis, TLS: rediss://default:<password>@<host>:<port>
REDIS_URL=
# Cloudflare > R2 > Manage API tokens: Object Read & Write, limited to vibe-testing-artifacts.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudflare API token: Workers Scripts, Containers, Workers R2 Storage, and Zone DNS + Workers Routes for tuetran.dev.
CLOUDFLARE_API_TOKEN=
# The first administrator. At least 10 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional: leave these empty and choose the provider, model and key in the app's Settings.
# Empty LLM_PROVIDER starts the app with anthropic as a placeholder (fake is refused in production).
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
