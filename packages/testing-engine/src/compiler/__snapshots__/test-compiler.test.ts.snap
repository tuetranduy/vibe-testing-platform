// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compilePlaywrightTest: the discovered flow (snapshot) > replays the golden path with semantic locators; every value comes from run-data.json 1`] = `
"// Generated by the AI testing platform from a discovered flow. Do not edit.
// Values live in run-data.json; secrets are read from SECRET_* environment variables.
import { expect, test } from "@playwright/test";
import { listContains, readNumber, readTextList } from "./helpers";
import data from "./run-data.json";

const softExpect = expect.configure({ soft: true });

test("discovered flow", async ({ page }) => {
  await page.goto(data.targetUrl);
  await page.getByRole("link", { name: data.locators.loc1.name, exact: true }).click();
  await page.getByRole("searchbox", { name: data.locators.loc2.name, exact: true }).fill(data.inputs.input1);
  await page.getByRole("link", { name: data.locators.loc3.name, exact: true }).click();
  // Checkpoint 1
  await page.waitForLoadState("load", { timeout: 10000 }).catch(() => {});
  const fact1 = await readNumber(page.getByTestId(data.locators.loc4.value));
  await page.getByRole("button", { name: data.locators.loc5.name, exact: true }).click();
  // Checkpoint 2
  await page.waitForLoadState("load", { timeout: 10000 }).catch(() => {});
  await test.step("[AC-1] " + data.criteria["AC-1"].statement, async () => {
    const message = "[AC-1] " + data.criteria["AC-1"].statement;
    expect.soft(fact1, message).not.toBeNull();
    await softExpect.poll(() => readNumber(page.getByTestId(data.locators.loc4.value), 0), { message }).toBeGreaterThan(fact1 ?? Number.NaN);
  });
  await test.step("[AC-2] " + data.criteria["AC-2"].statement, async () => {
    const message = "[AC-2] " + data.criteria["AC-2"].statement;
    await expect.soft(page.getByTestId(data.locators.loc6.value), message).toBeVisible();
  });
  await test.step("[AC-3] " + data.criteria["AC-3"].statement, async () => {
    const message = "[AC-3] " + data.criteria["AC-3"].statement;
    await expect.soft(page.getByRole("status", { name: data.locators.loc7.name, exact: true }), message).toContainText(data.criteria["AC-3"].value, { ignoreCase: true, useInnerText: true });
  });
  await test.step("[AC-4] " + data.criteria["AC-4"].statement, async () => {
    const message = "[AC-4] " + data.criteria["AC-4"].statement;
    await softExpect.poll(async () => listContains(await readTextList(page.getByTestId(data.locators.loc8.value), 0), data.criteria["AC-4"].item, "contains"), { message }).toBe(true);
  });
});
"
`;
