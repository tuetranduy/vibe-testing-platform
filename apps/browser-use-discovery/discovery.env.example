# Copy to discovery.env (gitignored) or point BROWSER_USE_DISCOVERY_ENV at your own file.
# The ONE URL a request may name. Node's survey opens it on the host (bin/serve-fixture); the agent gets the
# in-container copy of the same fixture on the same origin and never reaches the host.
DISCOVERY_FIXTURE_URL=http://127.0.0.1:4599/
# "scripted" = deterministic local model, no API key, no cost. Or a Pydantic AI model string, e.g.
#   DISCOVERY_MODEL=anthropic:claude-sonnet-5-5   (+ ANTHROPIC_API_KEY=... here: it stays in the host launcher)
DISCOVERY_MODEL=scripted
DISCOVERY_IMAGE=vtp-browser-use-discovery:1.0.6
# Required by --serve. Set a random token of at least 32 characters and share it with the platform.
# DISCOVERY_SERVICE_TOKEN=
# DISCOVERY_SERVICE_PORT=4600
# Docker CLI to use (PATH lookup by default). Docker Desktop on macOS may need its socket:
# DOCKER_HOST=unix:///Users/<you>/.docker/run/docker.sock
# Live interaction with public HTTPS sites: each job's inspecting egress proxy joins this plain bridge (created when
# missing) and lets only GET/HEAD/OPTIONS without a body reach the site. Subresource hosts: same-site, public or none.
#DISCOVERY_LIVE_SITES=on
#DISCOVERY_LIVE_EGRESS_NETWORK=vtp-discovery-live-egress
#DISCOVERY_LIVE_OTHER_HOSTS=same-site
# Concurrent agent containers in the job service (1-3); match the worker's BROWSER_USE_DISCOVERY_CAPACITY.
#DISCOVERY_JOB_SLOTS=1
